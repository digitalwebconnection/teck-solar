# ==========================================
# Teck Solar - Backend .gitignore
# Node.js / Express / MongoDB / Cloudinary
# ==========================================

# Dependencies
node_modules/
jspm_packages/

# Environment Variables & Sensitive Secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Process IDs & Runtime Lockfiles
pids/
*.pid
*.seed
*.pid.lock

# Temporary Storage & File Uploads
tmp/
temp/
uploads/
.cache/

# Testing & Code Coverage
coverage/
.nyc_output/

# IDE & Text Editor Configuration
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

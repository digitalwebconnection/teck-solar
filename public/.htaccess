# ==============================================================================
# TECK SOLAR - APACHE WEB SERVER CONFIGURATION (.htaccess)
# ==============================================================================

# ----------------------------------------------------------------------
# 1. REWRITE ENGINE & HTTPS REDIRECT
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback: Route all other requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 2. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevent clickjacking / framing
  Header set X-Frame-Options "SAMEORIGIN"

  # Enable XSS protection filter in browsers
  Header set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy (Disable unneeded device sensors)
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTTP Strict Transport Security (HSTS)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Remove server signature
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ----------------------------------------------------------------------
# 3. GZIP / DEFLATE COMPRESSION
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 4. BROWSER CACHING (EXPIRES HEADERS)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Always revalidate to serve new builds instantly
  ExpiresByType text/html "access plus 0 seconds"

  # CSS & JavaScript (Vite hashes filenames in production)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images and Icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Data / Feeds
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 5. BLOCK ACCESS TO SENSITIVE FILES
# ----------------------------------------------------------------------
<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>  
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes

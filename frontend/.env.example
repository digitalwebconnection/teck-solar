# ==========================================
# Teck Solar - Frontend Environment Variables (.env.example)
# ==========================================

# Backend API Base URL (leave empty in local dev to use Vite proxy, or set e.g. http://localhost:5000)
VITE_API_URL=

# Web3Forms API Key for contact form and quote requests
# Sign up and get your access key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
